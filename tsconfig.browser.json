{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true
    },
    "include": ["web/**/*.js"]
}
