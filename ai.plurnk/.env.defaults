# @plurnk/plurnk-web — optional document host. Sign-in uses the shared daemon authority.
# 1 = claim / on the daemon's listener; 0 = no routes. Read at daemon startup.
PLURNK_WEB_ENABLED=1
# Initial page preference: 0 = explicit review; 1 = automatically accept proposals.
# A worker page reached from another site, or on plain HTTP other than localhost, starts in explicit review.
# Read at startup; /yolo overrides this page only. Reload restores this setting.
# Questions and MCP input always require an answer. Daemon permission policy still applies.
PLURNK_WEB_YOLO=0
# Newest Unicode code points retained in the ephemeral live reasoning preview.
# Positive integer, read at startup. Full reasoning remains available on demand.
PLURNK_WEB_REASONING_PREVIEW_CHARS=4096
# Sign-in transactions, not authenticated session lifetimes. Each travels sealed in its
# browser's cookie. Seconds available to complete sign-in; positive integer. Read at startup.
PLURNK_WEB_LOGIN_TTL_SEC=600
# Workspace creation forms, not sign-in transactions or workspace lifetimes.
# Seconds a settled creation stays addressable, so a retry after a lost
# response converges to the same workspace; positive integer, read at startup.
PLURNK_WEB_CREATE_TTL_SEC=600
# Maximum retained in-flight and settled workspace creations per module.
# Beyond it the oldest unsubmitted, then settled, token yields; positive integer, read at startup.
PLURNK_WEB_CREATE_TOKENS=128
# Diagram compilation, not agent work. Positive integers, read at startup.
# Maximum parallel compiler threads. Workers start on demand and retire when idle.
PLURNK_WEB_DIAGRAM_THREADS=2
# Maximum admitted compilations, including queued work. Excess requests answer 429.
PLURNK_WEB_DIAGRAM_PENDING=16
# Milliseconds for queueing and compilation after source intake (1–2147483647).
# Expiry answers 408; the ceiling is Node's timer range, not a render policy.
PLURNK_WEB_DIAGRAM_TIMEOUT_MS=1000
# Maximum UTF-8 JSON request bytes. Excess input answers 413.
PLURNK_WEB_DIAGRAM_INPUT_BYTES=65536
# Maximum UTF-8 SVG response bytes. Compiler/output limits answer 422.
PLURNK_WEB_DIAGRAM_OUTPUT_BYTES=4000000
# Ondine's flowchart edge bound; other syntax limits remain the compiler's contract.
PLURNK_WEB_DIAGRAM_EDGES=5000
