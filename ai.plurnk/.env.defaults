# @plurnk/plurnk-web — optional document host. Sign-in uses the shared daemon authority.
# 1 = claim / on the daemon's listener; 0 = no routes. Read at daemon startup.
PLURNK_WEB_ENABLED=1
# 1 = automatically accept approval proposals; 0 = explicit review. Read at startup.
# Questions and MCP input always require an answer. Daemon permission policy still applies.
PLURNK_WEB_YOLO=1
# Pending authorization-code transactions, not authenticated session lifetimes.
# Seconds available to complete sign-in; positive integer. Read at startup.
PLURNK_WEB_LOGIN_TTL_SEC=600
# Maximum pending sign-ins per module; positive integer. Full queues answer 429.
PLURNK_WEB_LOGIN_PENDING=128
