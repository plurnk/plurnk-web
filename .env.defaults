# Browser client portal. The daemon remains a separately running service.
PLURNK_WEB_HOST=127.0.0.1
PLURNK_WEB_PORT=10660

# Shared PLURNK client target. PLURNK_AGUI_URL overrides HOST/PORT assembly.
PLURNK_HOST=127.0.0.1
PLURNK_PORT=1066

# The local client does not send dependency telemetry unless explicitly opted in.
COPILOTKIT_TELEMETRY_DISABLED=true
