# {§web-host} {§web-configuration} @plurnk/plurnk-web — optional document host (`--omit=optional` omits it).
# Brand identity, theme color, About links, and optional startup-loaded CSS/icon files.
# Read at startup; invalid values or unreadable files fail startup.
PLURNK_WEB_APP_NAME=Plurnk
PLURNK_WEB_APP_DESCRIPTION=Plurnk agent workspace.
PLURNK_WEB_THEME_COLOR="#148800"
PLURNK_WEB_ABOUT_LINKS='[{"label":"Report an issue","url":"https://github.com/plurnk/plurnk-service/issues"}]'
PLURNK_WEB_THEME_CSS_FILE=
PLURNK_WEB_ICON_FILE=
PLURNK_WEB_MASKABLE_ICON_FILE=
# Declarative host Settings extension tabs: JSON array of { id, label, htmlFile, scriptFile? }.
# Read and validated at startup; invalid values or unsafe/unreadable files fail startup.
PLURNK_WEB_SETTINGS_TABS='[]'
# Maximum non-gated model sessions loaded in the Search directory overview (/search/); gated sessions are always held.
# Positive integer, read at startup.
PLURNK_WEB_OVERVIEW_SESSIONS=200
# Maximum Unicode code points in a session card's single-line reply preview excerpt on /search/.
# Positive integer, read at startup.
PLURNK_WEB_OVERVIEW_EXCERPT_CHARS=160
# Diagram compilation, not agent work. Positive integers, read at startup.
# Maximum parallel compiler threads. Threads start on demand and retire when idle.
PLURNK_WEB_DIAGRAM_THREADS=2
# Maximum admitted compilations, including queued work. Excess requests answer 429.
PLURNK_WEB_DIAGRAM_PENDING=16
# Milliseconds for queueing and compilation after source intake (1–2147483647).
# Expiry answers 408; the ceiling is Node's timer range, not a render policy.
PLURNK_WEB_DIAGRAM_TIMEOUT_MS=1000
# Maximum UTF-8 JSON request bytes. Excess input answers 413.
PLURNK_WEB_DIAGRAM_INPUT_BYTES=65536
# Maximum UTF-8 SVG response bytes. Compiler/output limits answer 422.
PLURNK_WEB_DIAGRAM_OUTPUT_BYTES=4000000
# Ondine's flowchart edge bound; other syntax limits remain the compiler's contract.
PLURNK_WEB_DIAGRAM_EDGES=5000
