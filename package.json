{
  "name": "@plurnk/plurnk-web",
  "version": "0.1.0",
  "description": "Browser-native AG-UI client for PLURNK.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/plurnk/plurnk-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plurnk/plurnk-web.git"
  },
  "bugs": {
    "url": "https://github.com/plurnk/plurnk-web/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "plurnk-web": "bin/plurnk-web.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    ".env.defaults",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "npm run build && npm start",
    "build:clean": "node scripts/clean-dist.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:browser": "vite build --config vite.config.ts",
    "build": "npm run build:clean && npm run build:server && npm run build:browser",
    "test:lint": "tsc --noEmit",
    "test:unit": "node --test 'src/**/*.test.ts'",
    "test": "npm run test:lint && npm run test:unit && npm run build",
    "prepack": "npm test",
    "start": "node bin/plurnk-web.js"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/core": "^0.0.59",
    "@copilotkit/react-core": "1.70.0",
    "@copilotkit/runtime": "1.70.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "7.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
