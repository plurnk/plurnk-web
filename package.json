{
    "name": "@plurnk/plurnk-web",
    "version": "4.0.0",
    "description": "Plurnk daemon module serving an OTM document.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "homepage": "https://github.com/plurnk/plurnk-web#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-web.git"
    },
    "bugs": {
        "url": "https://github.com/plurnk/plurnk-web/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        "./module": {
            "types": "./types/module.d.ts",
            "default": "./src/module.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        ".env.defaults",
        "types/module.d.ts",
        "src/module.js",
        "src/index-document.js",
        "src/directory-addresses.js",
        "src/documents.js",
        "src/http.js",
        "src/static-assets.js",
        "src/diagrams.js",
        "src/diagram-compiler.js",
        "dist/",
        "README.md",
        "SPEC.md",
        "LICENSE"
    ],
    "dependencies": {
        "@plurnk/plurnk-meta": "^3.0.0 || ^4.0.0",
        "negotiator": "1.1.0",
        "ondine": "0.0.2",
        "piscina": "5.3.2"
    },
    "peerDependencies": {
        "@plurnk/plurnk-acp": "^3.0.0 || ^4.0.0",
        "@plurnk/plurnk-contracts": "^9.0.0 || ^10.0.0",
        "@plurnk/plurnk-modules": "^4.3.0 || ^5.0.0"
    },
    "devDependencies": {
        "@agentclientprotocol/sdk": "2.12.0",
        "@eslint/js": "10.0.1",
        "@plurnk/plurnk-spec-check": "^0.2.0 || ^0.3.0",
        "@types/negotiator": "0.6.5",
        "@types/node": "^26.6.6",
        "@xterm/headless": "6.0.0",
        "dompurify": "3.4.18",
        "eslint": "10.15.0",
        "eslint-plugin-no-unsanitized": "4.1.5",
        "globals": "17.14.0",
        "highlight.js": "11.12.0",
        "marked": "18.2.1",
        "marked-footnote": "1.4.0",
        "node-pty": "1.1.0",
        "on_the_money": "0.15.0",
        "playwright": "1.65.1",
        "stylelint": "18.0.0",
        "stylelint-config-standard": "41.0.0",
        "temml": "0.14.0",
        "typescript": "^7.0.2",
        "vite": "8.3.8",
        "zod": "4.6.7"
    },
    "allowScripts": {
        "node-pty@1.1.0": true
    },
    "scripts": {
        "dev": "node scripts/assets.mjs && vite",
        "build": "node scripts/build.mjs",
        "preview": "vite preview",
        "test:lint": "plurnk-spec-check && tsc && tsc -p tsconfig.browser.json && tsc -p tsconfig.test.json && eslint . && otm-lint --check web && stylelint 'web/styles/*.css'",
        "test:unit": "node --env-file=.env.defaults --test test/module.test.js test/route-settlement.test.js test/diagrams.test.js test/build.test.js test/development.test.js test/authoring.test.js test/directory-addresses.test.js test/oidc.test.js test/documents.test.js test/session-status.test.js test/schedule-panel.test.js test/reading-slate.test.js test/history-pages.test.js test/conversation.test.js test/package.test.js",
        "test:installation": "node --test test/installation.test.js",
        "test:candidate": "node scripts/test-candidate.mjs",
        "test": "npm run build && npm run test:lint && npm run test:unit",
        "prepack": "npm run build",
        "prepublishOnly": "npm test"
    }
}
