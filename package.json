{
    "name": "@plurnk/plurnk-web",
    "version": "0.1.0",
    "description": "Optional Plurnk daemon module serving an OTM document.",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "repository": {
        "type": "git",
        "url": "ssh://git@ssh.possumtech.com/plurnk/plurnk-web.git"
    },
    "bugs": {
        "url": "https://repo.possumtech.com/plurnk/plurnk-web/issues"
    },
    "files": [
        "plugin.json",
        "ai.plurnk/module.js",
        "ai.plurnk/index-document.js",
        "ai.plurnk/directory-addresses.js",
        "ai.plurnk/documents.js",
        "ai.plurnk/session.js",
        "ai.plurnk/http.js",
        "ai.plurnk/.env.defaults",
        "ai.plurnk/assets.json",
        "ai.plurnk/dist/",
        "README.md",
        "SPEC.md",
        "LICENSE"
    ],
    "dependencies": {
        "@plurnk/plurnk-meta": "^2.1.1",
        "oauth4webapi": "3.8.8"
    },
    "peerDependencies": {
        "@plurnk/plurnk-contracts": "^3.2.0",
        "@plurnk/plurnk-modules": "^3.1.0"
    },
    "devDependencies": {
        "@ag-ui/client": "1.0.2",
        "@fullhuman/postcss-purgecss": "8.0.0",
        "@picocss/pico": "2.1.1",
        "@plurnk/plurnk-agui": "^3.1.0",
        "@plurnk/plurnk-spec-check": "0.1.0",
        "@types/node": "^26.1.1",
        "eslint": "10.12.0",
        "eslint-plugin-no-unsanitized": "4.1.5",
        "on_the_money": "0.10.0",
        "playwright": "1.64.0",
        "stylelint": "17.16.0",
        "stylelint-config-standard": "40.0.0",
        "typescript": "^7.0.2",
        "vite": "8.3.4",
        "zod": "3.25.76"
    },
    "scripts": {
        "dev": "node scripts/assets.mjs && vite",
        "build": "node scripts/build.mjs",
        "preview": "vite preview",
        "test:lint": "plurnk-spec-check && tsc && tsc -p tsconfig.browser.json && eslint web && otm-lint --check web && stylelint 'web/styles/*.css'",
        "test:unit": "node --env-file=ai.plurnk/.env.defaults --test test/module.test.js test/build.test.js test/development.test.js test/authoring.test.js test/directory-addresses.test.js test/session.test.js test/token.test.js test/documents.test.js test/worker-status.test.js",
        "test:installation": "node --test test/installation.test.js",
        "test:candidate": "node scripts/test-candidate.mjs",
        "test": "npm run build && npm run test:lint && npm run test:unit && npm run test:installation",
        "prepack": "npm run build"
    }
}
